# ----------------------------------------------------------------------------
# Required
# ----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_GENAI_USE_VERTEXAI=True

# Vertex region for embeddings + relationship classifier (text-embedding-005
# and Gemini Flash are billed in this region).
VERTEX_LOCATION=us-central1

# ----------------------------------------------------------------------------
# Optional — Dataplex glossary defaults
# ----------------------------------------------------------------------------
DATAPLEX_GLOSSARY_LOCATION=global
DATAPLEX_API_ENDPOINT=dataplex.googleapis.com

# ----------------------------------------------------------------------------
# Models
# ----------------------------------------------------------------------------
GLOSSARY_AGENT_MODEL=gemini-3-flash-preview
GLOSSARY_AGENT_CLASSIFIER_MODEL=gemini-3-flash-preview
GLOSSARY_AGENT_EMBEDDING_MODEL=text-embedding-005
# 0 → use the model's default dim (768 for text-embedding-005).
GLOSSARY_AGENT_EMBEDDING_DIM=0
GLOSSARY_AGENT_EMBEDDING_BATCH=100

# ----------------------------------------------------------------------------
# Ingestion limits
# ----------------------------------------------------------------------------
GLOSSARY_AGENT_MAX_GCS_DOCS=50
GLOSSARY_AGENT_MAX_DOC_BYTES=524288

# ----------------------------------------------------------------------------
# Document AI (enables PDF / image / DOCX / PPTX / XLSX / HTML ingestion).
# Leave DOCUMENT_AI_PROCESSOR_ID empty to disable; binary docs are skipped.
# Recommended processor type: Layout Parser.
# ----------------------------------------------------------------------------
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=
DOCUMENT_AI_PROCESSOR_VERSION=

# ----------------------------------------------------------------------------
# Recommendation thresholds (sane defaults — tune per domain)
# ----------------------------------------------------------------------------
# Drop candidate (term, entry) link pairs below this cosine before the
# LLM relationship classifier runs.
GLOSSARY_AGENT_LINK_COSINE_MIN=0.45
# Trigger lineage propagation when a definition link is at/above this cosine.
GLOSSARY_AGENT_LINK_COSINE_STRONG=0.72
# When extending an existing glossary, candidate terms within this cosine
# of an existing term are treated as duplicates.
GLOSSARY_AGENT_DEDUP_COSINE=0.78

# Clustering knobs for category proposal.
GLOSSARY_AGENT_CLUSTER_DISTANCE=0.55
GLOSSARY_AGENT_MIN_CLUSTER_SIZE=3
GLOSSARY_AGENT_MAX_CATEGORIES=10
GLOSSARY_AGENT_MAX_TERMS=40

# Hard cap on (term, entry) pairs sent to the LLM relationship classifier.
GLOSSARY_AGENT_MAX_CLASSIFIER_PAIRS=200

# ----------------------------------------------------------------------------
# Data Lineage (opt-in; required for related-link propagation).
# When enabled, lineage calls are hard-required to succeed.
# ----------------------------------------------------------------------------
GLOSSARY_AGENT_USE_LINEAGE=false
LINEAGE_LOCATION=us
LINEAGE_MAX_HOPS=1
LINEAGE_MAX_NEIGHBORS=25
